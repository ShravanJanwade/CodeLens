# Copy to .env.production for a direct Node / Docker Compose deployment.
# On a managed host, add these as service environment variables instead.
NODE_ENV=production
PORT=4000
APP_ORIGIN=https://your-codelens-host.example
CORS_ORIGIN=https://your-codelens-host.example
# Container path. Direct Node: use an absolute path writable by its service user.
DATABASE_URL=/data/codelens.db
# Generate TWO different values: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_FIRST_RANDOM_VALUE
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_SECOND_RANDOM_VALUE

# GitHub Developer settings > OAuth Apps. Never prefix these with VITE_.
# Callback: https://your-codelens-host.example/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

AI_PROVIDER=demo
# Optional: change provider to gemini and set both values.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional local/self-hosted provider (reachable FROM the API host):
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5:7b

PUBLIC_DEMO=false
MAX_REPOSITORY_SIZE=26214400
MAX_FILES_PER_ANALYSIS=500
MAX_AGENT_STEPS=25
MAX_TOOL_CALLS_PER_RUN=30
MAX_TELEMETRY_EVENTS_PER_MINUTE=500
MAX_API_REQUESTS_PER_MINUTE=120
# Optional dedicated prepared-fixture PostgreSQL database:
# TASKFORGE_DATABASE_URL=postgresql://taskforge:PASSWORD@postgres:5432/taskforge
# HTTP journeys work without Chromium. Only enable after installing Chromium:
PLAYWRIGHT_JOURNEYS=false
# Per-repository webhooks generate/encrypt their own secret in the app.
# GITHUB_WEBHOOK_SECRET is only for the older shared webhook endpoint.
