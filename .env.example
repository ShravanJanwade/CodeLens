# Local-first configuration. No commercial API key is required.
PORT=4000
DATABASE_URL=./data/codelens.db
AI_PROVIDER=demo
# Optional server-side Gemini: set AI_PROVIDER=gemini and both variables.
# GEMINI_API_KEY=
# GEMINI_MODEL=your-enabled-free-tier-model
# Public deployment restricts writes to prepared fixture rehearsals.
# PUBLIC_DEMO=true
# Rehearsals default to isolated SQLite. PostgreSQL requires a dedicated fixture database.
# TASKFORGE_DATABASE_URL=postgresql://taskforge:taskforge@localhost:5433/taskforge
# Generate a unique value before exposing the API beyond localhost.
JWT_SECRET=replace-with-a-long-random-local-secret
CORS_ORIGIN=http://localhost:3000
APP_ORIGIN=http://localhost:3000
# GitHub OAuth app. Callback: APP_ORIGIN/api/v1/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Optional dedicated high-entropy key for encrypted GitHub tokens.
# Set this before connecting GitHub. Changing it requires reconnecting accounts.
# TOKEN_ENCRYPTION_KEY=

# Optional local AI. Install Ollama and a compatible model first, then set:
# AI_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# Conservative limits for cost and reliability safety.
MAX_REPOSITORY_SIZE=26214400
MAX_FILES_PER_ANALYSIS=500
MAX_AGENT_STEPS=25
MAX_TOOL_CALLS_PER_RUN=30
MAX_TELEMETRY_EVENTS_PER_MINUTE=500
MAX_API_REQUESTS_PER_MINUTE=60

# Optional GitHub webhook intake. Generate a high-entropy secret in the
# GitHub App/webhook settings and never commit its value.
# GITHUB_WEBHOOK_SECRET=
