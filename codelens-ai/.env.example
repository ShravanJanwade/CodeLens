# GitHub Token (optional, increases rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=ghp_your_github_token

# Groq API Key (free tier: https://console.groq.com)
# Used for LLM chat completions
GROQ_API_KEY=gsk_your_groq_api_key

# Embedding API Key (OpenAI or compatible provider)
# Used for generating code embeddings. Options:
# - OpenAI: Get key from https://platform.openai.com/api-keys
# - Or leave empty to use lightweight local fallback embeddings
OPENAI_API_KEY=sk_your_openai_api_key
# Or use custom embedding provider:
# EMBEDDING_API_KEY=your_embedding_api_key
# EMBEDDING_API_URL=https://api.your-provider.com/v1/embeddings
# EMBEDDING_MODEL=text-embedding-3-small

# Gateway settings
JWT_SECRET=change-this-to-a-secure-random-string
PORT=8080
